APP_NAME="Kai's Coffee"
APP_ENV=local                  # local | staging | production
APP_KEY=
APP_DEBUG=true                 # set false in staging & production
APP_URL=http://localhost:8000  # public URL of this API (no trailing slash)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack              # set LOG_CHANNEL=stderr in production (containers)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                # use "error" in production

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kais_coffee
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kaiscoffee.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS & Auth ───────────────────────────────────────────────────────────────
# FRONTEND_URL: comma-separated list of allowed origins for CORS.
# Also used by Sanctum for stateful-domain cookie auth (SPA mode).
#
#   Development:   FRONTEND_URL=http://localhost:3000
#   Multi-domain:  FRONTEND_URL=https://kaiscoffee.com,https://www.kaiscoffee.com
#   Staging+prod:  FRONTEND_URL=https://staging.kaiscoffee.com,https://kaiscoffee.com
FRONTEND_URL=http://localhost:3000

# SANCTUM_STATEFUL_DOMAINS: comma-separated host[:port] values that receive
# session cookies.  Must match the Host header sent by the browser (no https://).
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── Reverse proxy / load balancer trust ──────────────────────────────────────
# Required when the API is behind nginx, an AWS ALB, Cloudflare, or Laravel Forge
# so that $request->ip(), isSecure(), and getHost() reflect the real client.
#
#   ''             → off (safe default; use for direct-to-internet servers)
#   '*'            → trust all proxies (only safe when the firewall blocks outside IPs)
#   '10.0.0.1'     → trust a specific proxy IP
#   '10.0.0.0/8'   → trust a CIDR range (comma-separate multiple)
TRUSTED_PROXIES=

# ── File uploads ──────────────────────────────────────────────────────────────
# Development  → UPLOAD_DISK=public  (stored locally, served via /storage symlink)
#                Run once: php artisan storage:link
# Production   → UPLOAD_DISK=s3      (set the AWS_* vars below)
UPLOAD_DISK=public

# ── S3 / cloud object storage (required when UPLOAD_DISK=s3) ─────────────────
# Standard AWS S3:
#   AWS_ACCESS_KEY_ID      IAM key with s3:PutObject, s3:DeleteObject on the bucket
#   AWS_SECRET_ACCESS_KEY  Corresponding secret
#   AWS_DEFAULT_REGION     e.g. us-east-1
#   AWS_BUCKET             Bucket name (must allow public reads)
#   AWS_URL                (optional) CDN/CloudFront URL, e.g. https://cdn.kaiscoffee.com
#                          Leave blank to use the native S3 URL.
#
# S3-compatible (MinIO, Cloudflare R2, DigitalOcean Spaces, etc.):
#   Also set AWS_ENDPOINT and AWS_USE_PATH_STYLE_ENDPOINT=true if needed.
#
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=us-east-1
#AWS_BUCKET=
#AWS_URL=
#AWS_ENDPOINT=
#AWS_USE_PATH_STYLE_ENDPOINT=false
