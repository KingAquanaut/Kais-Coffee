APP_NAME="Kai's Coffee"
APP_ENV=local                  # local | staging | production
APP_KEY=
APP_DEBUG=true                 # set false in staging & production
APP_URL=http://localhost:8000  # public URL of this API (no trailing slash)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack              # set LOG_CHANNEL=stderr in production (containers)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                # use "error" in production

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kais_coffee
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kaiscoffee.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS & Auth ───────────────────────────────────────────────────────────────
# FRONTEND_URL: comma-separated list of allowed origins for CORS.
# Also used by Sanctum for stateful-domain cookie auth (SPA mode).
#
#   Development:   FRONTEND_URL=http://localhost:3000
#   Multi-domain:  FRONTEND_URL=https://kaiscoffee.com,https://www.kaiscoffee.com
#   Staging+prod:  FRONTEND_URL=https://staging.kaiscoffee.com,https://kaiscoffee.com
FRONTEND_URL=http://localhost:3000

# SANCTUM_STATEFUL_DOMAINS: comma-separated host[:port] values that receive
# session cookies.  Must match the Host header sent by the browser (no https://).
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── Reverse proxy / load balancer trust ──────────────────────────────────────
# Required when the API is behind nginx, an AWS ALB, Cloudflare, or Laravel Forge
# so that $request->ip(), isSecure(), and getHost() reflect the real client.
#
#   ''             → off (safe default; use for direct-to-internet servers)
#   '*'            → trust all proxies (only safe when the firewall blocks outside IPs)
#   '10.0.0.1'     → trust a specific proxy IP
#   '10.0.0.0/8'   → trust a CIDR range (comma-separate multiple)
TRUSTED_PROXIES=

# ── Image uploads (Cloudinary) ────────────────────────────────────────────────
# All admin image uploads (menu items, hero images, team photos) go to
# Cloudinary. The database stores only the returned secure URL.
#
# Copy the CLOUDINARY_URL from your Cloudinary dashboard → Settings → API Keys.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Optional: top-level folder in your Cloudinary media library.
# Keeps all Kai's Coffee assets organised under one root.
CLOUDINARY_FOLDER=kais-coffee
